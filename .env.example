# GEMINI_API_KEY: Optional Gemini AI API key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Cloud SQL runtime environment variables (automatically injected by platform)
SQL_HOST="/cloudsql/YOUR_PROJECT:YOUR_REGION:YOUR_INSTANCE"
SQL_DB_NAME="elevator_crm"
SQL_USER="postgres"
SQL_PASSWORD="your_database_password"

# Schema management environment variables (used by drizzle-kit)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_admin_password"
